# Copy to `.env` and fill in real values. Never commit secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin allowlist (comma-separated). Also reads email from admin-credentials.txt.
ADMIN_EMAILS=

# Student voting cookie signing secret (required in production)
STUDENT_SESSION_SECRET=

# OTP email via Resend (https://resend.com/api-keys)
# Leave empty in local dev to log codes to the server console instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Envision <onboarding@resend.dev>
